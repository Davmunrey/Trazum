{
  "name": "trazum",
  "version": "0.2.0",
  "private": true,
  "description": "Optimizador de prompts: reduce el coste de tus llamadas a la IA sin perder calidad.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Davmunrey/Trazum.git"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build -w @trazum/core && npm run build -w @trazum/cli",
    "test": "npm run test -w @trazum/core",
    "dev:web": "npm run dev -w @trazum/web",
    "build:web": "npm run build -w @trazum/web",
    "trazum": "node packages/cli/dist/index.js"
  }
}
