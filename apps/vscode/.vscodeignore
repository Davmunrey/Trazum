# What stays out of the .vsix.
#
# The extension ships the built output and the two documents a reader needs.
# Sources, tests and build configuration are in the repository for anyone who
# wants them, and shipping them would put this package's test fixtures on
# somebody's machine for no reason.
src/**
test/**
tsconfig.json
**/*.map
**/*.ts
!dist/**/*.js

# The one package the extension imports at run time. `scripts/release-assets.mjs`
# lays it out under node_modules from the lockfile's own closure (built files
# only, no sources and no maps), and nothing else in node_modules ships: the
# first .vsix this repository built, in 1.86.0, left it out and would have
# failed to start for want of it.
node_modules/**
!node_modules/@trazum/core/package.json
!node_modules/@trazum/core/LICENSE
!node_modules/@trazum/core/dist/**/*.js
