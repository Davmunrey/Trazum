node_modules/
dist/
.next/
out/
*.tsbuildinfo
.env
.env.local
.DS_Store

# Third-party agent skills installed with `npx skills add` (taste-skill,
# impeccable, emilkowalski/skills). Local design tooling, not part of the
# product: ~3.9 MB of code that the installer itself warns "runs with full
# agent permissions", which does not belong in a repository whose stated
# posture is zero runtime dependencies. Anyone who wants them runs one command.
/.agents/
/.claude/skills/*
!/.claude/skills/trazum/
!/.claude/skills/trazum-review/

# Lockfile for third-party agent skills; see .gitignore
skills-lock.json

# The .vsix `npm run package:vscode` writes.
#
# The packaging step produces an installable file beside the extension, and the
# guard against runtime state in this repository checks the *tracked* tree — an
# untracked artefact is somebody's local mess. That is the right rule and it is
# also how a binary gets in: `git add -A` before a commit sweeps up whatever the
# last command left behind, which is exactly how sixty waiver records reached
# `main` and sat there for two releases. Ignored so the documented command
# cannot cost somebody that.
*.vsix

# The MCP bundle, and the folder scripts/release-assets.mjs writes into: the
# release carries them, the repository does not.
*.mcpb
/release-assets/

# Written by `npm run coverage`; the Coverage workflow uploads it and nothing keeps it.
/coverage/

# Written by `scripts/build-docs-site.mjs` from the repository's own documents,
# before the web app builds, runs or is tested: the pages of /docs and the
# images they use. A committed copy would be a second copy of the documents.
/apps/web/lib/docs/generated/
/apps/web/public/docs-assets/

# Also written by `scripts/build-docs-site.mjs`: the documents as `llms.txt` (an
# index) and `llms-full.txt` (one file). A committed copy would churn on every
# edit of any document.
/apps/web/public/llms.txt
/apps/web/public/llms-full.txt

# Written by `scripts/build-site-pages.mjs` from CHANGELOG.md, ROADMAP.md,
# .github/milestones.json and the catalogue's source, before the web app
# builds, runs or is tested: the pages of /changelog, /roadmap and the part of
# /models that is not the catalogue itself. A committed copy would be a second
# copy of the changelog.
/apps/web/lib/history/generated/
