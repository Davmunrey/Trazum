{
  "name": "@trazum/cli",
  "version": "0.5.0",
  "description": "Trazum CLI: optimise prompts, enforce token budgets in CI and price the savings from your terminal.",
  "license": "MIT",
  "author": "David Mu\u00f1oz Rey",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Davmunrey/Trazum.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "prompt",
    "llm",
    "tokens",
    "cost",
    "cli",
    "ci"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "trazum": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.js"
  },
  "dependencies": {
    "@trazum/core": "0.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
