{
  "level": "safe",
  "extensions": [
    ".txt"
  ],
  "usage": {
    "model": "claude-opus-5",
    "callsPerMonth": 1000,
    "avgOutputTokens": 300,
    "cacheHitRate": 0,
    "batchEligible": false
  },
  "budgets": {
    "examples/**": 600
  },
  "baseline": {
    "path": "trazum.baseline.json",
    "maxGrowthTokens": 25
  },
  "ignore": [
    "**/test/**",
    "**/tests/**",
    "**/fixtures/**",
    "**/corpus/**",
    "action/**"
  ]
}
