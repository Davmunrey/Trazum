# Proveedor de LLM para la pasada opcional de compresión semántica.
# Sin esto, Trazum funciona igual en modo determinista (que es gratis).

# openai = cualquier endpoint con formato /chat/completions
# anthropic = Claude API (/v1/messages)
TRAZUM_LLM_PROVIDER=openai

# URL base SIN /chat/completions al final.
TRAZUM_LLM_BASE_URL=https://tu-llm.example.com/v1

# Identificador del modelo tal y como lo espera tu endpoint.
TRAZUM_LLM_MODEL=nombre-del-modelo

# Clave de API, si tu endpoint la pide.
TRAZUM_LLM_API_KEY=

# Solo para "trazum optimize --exact-tokens": recuento exacto de tokens
# usando el endpoint oficial, que no cobra tokens.
ANTHROPIC_API_KEY=
