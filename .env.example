# LLM provider for the optional semantic-compression pass.
# Without this, Trazum works exactly the same in deterministic mode (which is free).

# openai = any endpoint speaking the /chat/completions format
# anthropic = Claude API (/v1/messages)
TRAZUM_LLM_PROVIDER=openai

# Base URL, WITHOUT /chat/completions on the end.
TRAZUM_LLM_BASE_URL=https://your-llm.example.com/v1

# Model identifier, exactly as your endpoint expects it.
TRAZUM_LLM_MODEL=model-name

# API key, if your endpoint asks for one.
TRAZUM_LLM_API_KEY=

# Language of the CLI report: en (default) or es. The --locale flag wins over
# this, and this wins over LANG. It changes the report only, never the
# optimisation.
TRAZUM_LOCALE=en

# Only for "trazum optimize --exact-tokens": exact token counting through the
# official endpoint, which does not charge for tokens.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Web only (@trazum/web)
# ---------------------------------------------------------------------------

# Public URL of the deployment, for OG metadata. Vercel infers this on its own.
NEXT_PUBLIC_SITE_URL=

# PostHog analytics, OFF by default. Only switched on when you set the key.
# Prompt content is never sent: aggregate metrics only.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
